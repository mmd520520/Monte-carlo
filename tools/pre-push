#!/usr/bin/env bash
# 推送保护（由 tools/sync_private.sh 安装到 .git/hooks/pre-push）。
# 只有 git config mcsim.privateRemotes 里登记的远程，才能收到：
#   - private/* 分支
#   - 文件里含 internal/、slides/、outputs/ 或 references/ 下（README.md 以外）文件的提交
remote=$1
allowed=" $(git config --get mcsim.privateRemotes || true) "
[[ $allowed == *" $remote "* ]] && exit 0

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref _; do
  [[ $local_sha == "$zero" ]] && continue
  if [[ $remote_ref == refs/heads/private/* ]]; then
    echo "pre-push：$remote 不是登记的私有远程，拒绝推送 $remote_ref" >&2; status=1; continue
  fi
  if [[ -n $(git ls-tree --name-only "$local_sha" -- internal slides outputs) ]] ||
     git ls-tree --name-only "$local_sha" references/ | grep -qv '^references/README.md$'; then
    echo "pre-push：$local_ref 含不能公开的文件（internal/、slides/、outputs/、references/），拒绝推送到 $remote" >&2
    status=1
  fi
done
[[ $status == 0 ]] || echo "确认对方是私有仓库后，可登记：git config mcsim.privateRemotes \"$(echo $allowed $remote)\"" >&2
exit $status
